APP_NAME="RM Consuegra Soporte"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Santo_Domingo
APP_URL=http://localhost

# Produccion (Linux):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://soporte.tudominio.local
# LOG_LEVEL=error

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_DO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=soporte_rm
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produccion HTTPS:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@rmconsuegra.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Super admin (DatabaseSeeder / SuperAdminSeeder)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@rmconsuegra.local
SUPER_ADMIN_PASSWORD=SuperAdmin123!

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Valores literales (Vite no expande ${REVERB_*})
# En produccion detras de Nginx, el navegador usa el host publico:
# VITE_REVERB_HOST=soporte.tudominio.local
# VITE_REVERB_PORT=80
# VITE_REVERB_SCHEME=http
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# LiveKit Cloud (plan gratis = más barato). https://cloud.livekit.io
# Proyecto → Settings → Keys → copiar URL (wss://…), API Key y Secret
LIVEKIT_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=7200
LIVEKIT_RING_TIMEOUT=45
# Modo económico (plan Build gratis)
LIVEKIT_ALLOW_VIDEO=false
LIVEKIT_MAX_CALL_MINUTES=20
LIVEKIT_VIDEO_QUALITY=low
